# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public privacy contact shown to guests. Set a real restaurant contact before production.
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=
DEPLOYMENT_ENV=local

# Neon Postgres (phase 2): use a local or preview Neon branch only.
# Copy this file to .env.local. Never copy a production connection string there.
DATABASE_URL=

# Neon Auth (phase 4)
NEON_AUTH_BASE_URL=

# Local-only credentials for browser tests. Never set these in preview or production.
TEST_STAFF_EMAIL=
TEST_STAFF_PASSWORD=
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=

# Optional easy-to-remember admin login for demoing before real staff accounts exist
# (grants access to both /personale and /menuadmin). Only provisioned locally when
# set — run `npm run db:provision-dev-auth` after adding these. Login still requires
# a valid email shape and an 8+ character password; there is no way to make literal
# "admin"/"admin" work without weakening that check for everyone, including the
# public internet if this deployment isn't otherwise access-restricted. Unset (or
# rotate the password) before real go-live.
ADMIN_DEMO_EMAIL=
ADMIN_DEMO_PASSWORD=

# Restaurant notification mail (phase 5)
# disabled is safe by default. sandbox calls Brevo with X-Sib-Sandbox: drop;
# live is only for the production environment after sender verification.
BREVO_DELIVERY_MODE=disabled
RESTAURANT_NOTIFICATION_EMAIL=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SANDBOX_RECIPIENT=

# Auth email (individual staff accounts): password-reset, email-verification and
# sign-in-link emails for Neon Auth are sent by app/api/auth/neon-webhook, using
# Resend instead of Neon's default templates. Separate from Brevo above, which
# stays the restaurant's operational-order channel — two providers, two purposes.
# Get RESEND_API_KEY from https://resend.com/api-keys (mail.hansendjurhuus.dk is
# already verified there). After deploying, register the webhook once — see
# docs/AUTH.md "Webhook-registrering".
RESEND_API_KEY=
AUTH_MAIL_FROM_NAME=Tee-Time
AUTH_MAIL_FROM_ADDRESS=konto@mail.hansendjurhuus.dk

# Vercel Cron authorization; generate a long random value per environment.
CRON_SECRET=

# Kitchen ticket printing. Leave empty until a printer is chosen: tickets queue in
# print_outbox and stay "blocked" instead of being lost. Once a printer/print-relay
# with an HTTP ingest endpoint is selected, set its URL here to start delivering.
KITCHEN_PRINTER_URL=

# Product/offer image uploads in menuadmin (Vercel Blob). In Vercel: Storage -> Create
# a Blob store -> connect it to this project. Newer Blob stores authenticate via OIDC
# (VERCEL_OIDC_TOKEN, already injected for linked projects, + BLOB_STORE_ID below)
# rather than a static token. Run `vercel env pull .env.local` after connecting to
# pull both. If your store instead issues a classic BLOB_READ_WRITE_TOKEN, set that
# one var alone and leave BLOB_STORE_ID empty. Without either, uploads fail with a
# clear "not configured yet" error instead of crashing.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
